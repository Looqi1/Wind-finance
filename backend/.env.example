WINDFINANCE_SECRET_KEY=replace-this-with-a-long-random-secret
WINDFINANCE_ENV=prod
WINDFINANCE_SIMULATOR=0
WINDFINANCE_ALLOWED_ORIGINS=https://app.example.com
DATABASE_URL=postgresql+psycopg://user:password@localhost/windfinance
PUBLIC_BASE_URL=https://your-backend.example
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
WINDFINANCE_STARS_PRICES={}
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_API_BASE_URL=https://api-testnet.bybit.com
BYBIT_ADMIN_USER_IDS=
BYBIT_MAX_NOTIONAL_USDT=100
WINDFINANCE_LIVE_TRADING=0

# Customer-owned spot accounts. Set these on the HTTPS API host after Bybit approves OAuth.
# Leave the network empty to use the public learning demo and P2P links.
BYBIT_BROKER_NETWORK=
BYBIT_BROKER_ID=
BYBIT_OAUTH_CLIENT_ID=
BYBIT_OAUTH_CLIENT_SECRET=
BYBIT_OAUTH_REDIRECT_URI=
BYBIT_BROKER_ENCRYPTION_KEY=
